  R[Resource] --> L[Language]
  R --> C[Corpus]
  R --> D[Dictionary]
  R --> G[Grammar]
  R --> M[Media]
  R --> E[Education]

  L --> COL[Collection]
  COL --> TXT[Text]
  TXT --> S[Sentence]
  S --> T[Token]
  S --> TR[Translation]
  T --> MA[Morphological Analysis]
  T --> SA[Syntactic Analysis]
  T --> LL[Lexical Link]
  LL --> LEM[Lemma]
  LEM --> DE[Dictionary Entry]
  DE --> SEN[Sense]
  SEN --> EX[Corpus Example Link]
  EX --> S

  LEM --> CON[Concept]
  CON --> TAX[Taxon / Cultural Entity]
  CON --> M
  TXT --> M
  S --> M
  LEM --> M

  G --> GT[Grammar Topic]
